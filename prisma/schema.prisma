datasource db {
  provider     = "mongodb"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String     @id @map("_id")
  username    String     @default("")
  avatar      String?
  balance     Int        @default(0)
  totalSpent  Int        @default(0)
  blacklisted Boolean    @default(false)
  lastDaily   DateTime?
  receipts    Receipt[]
  payments    Payment[]
}

model Category {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  name     String    @unique
  products Product[]
}

model Product {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  price        Int
  description  String?
  isFixed      Boolean   @default(false)
  fixedContent String?
  discountRate Int       @default(0)
  categoryId   String    @db.ObjectId
  category     Category  @relation(fields: [categoryId], references: [id])
  stocks       Stock[]
  receipts     Receipt[]
}

model Stock {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  content   String
  isSold    Boolean  @default(false)
}

model Payment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  amount       Int
  points       Int
  senderName   String
  status       String   @default("PENDING")
  type         String   @default("AUTO")
  expired      Boolean  @default(false)
  logChannelId String?
  logMessageId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Receipt {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  productId        String    @db.ObjectId
  product          Product   @relation(fields: [productId], references: [id])
  paidAmount       Int
  deliveredContent String
  hasReview        Boolean  @default(false)
  reviewRating     Int?
  reviewContent    String?
  purchasedAt      DateTime @default(now())
}

model RoleReward {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  spentLimit   Int
  roleId       String
  discountRate Int      @default(0)
}

model SystemSetting {
  key   String @id @map("_id")
  value String
}

model EmbedSetting {
  id          String  @id @default("main_shop") @map("_id")
  title       String  @default("Welcome to the shop")
  description String  @default("Use the buttons below to open the features you need.")
  color       String  @default("#5865F2")
  imageUrl    String?
  footerText  String?
}

model Session {
  sid       String   @id @map("_id")
  data      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}
