<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>최저가 NO.1 발로랜계 킬조이샵 [24H]</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/png" href="/favicon.png">
</head>
<body>
  <div class="dashboard-container">
    <aside class="sidebar">
      <h1 class="sidebar-title">킬조이샵</h1>
      <nav class="sidebar-nav">
        <a href="/admin" class="nav-link"><span></span> 월간 실적</a>
        <a href="/admin/products" class="nav-link active"><span></span> 제품</a>
        <a href="/admin/logs" class="nav-link"><span></span> 로그</a>
        <a href="/admin/settings" class="nav-link"><span></span> 설정</a>
        <a href="/admin/embed" class="nav-link"><span></span> 임베드</a>
        <a href="/admin/roles" class="nav-link"><span></span> 역할 지급</a>
      </nav>
      <div class="sidebar-footer">
        <div class="user-profile">
                  <% if (user.avatar) { %>
                    <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=128" class="user-avatar" alt="프로필">
                  <% } else { %>
                    <img src="https://cdn.discordapp.com/embed/avatars/0.png" class="user-avatar" alt="프로필">
                  <% } %>
                  <div class="user-name"><%= user.username || '관리자' %></div>
                </div>
                <a href="/dashboard" class="nav-link"><span>👤</span> 내 대시보드</a>
                <a href="/auth/logout" class="logout-link-animated"><span>🚪</span> 로그아웃</a>
      </div>
    </aside>
        <main class="main-content">
      <div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start;">
        <h1 class="title-md">제품 관리</h1>
        <div class="flex gap-2" style="margin-top: 8px;">
          <button onclick="openRestockLogModal()" class="btn btn-success">📢 입고 로그</button>
          <button onclick="openCategoryModal()" class="btn btn-primary">📁 카테고리 추가</button>
        </div>
      </div>

      <div id="categoryList">
        <div class="text-muted">로딩중...</div>
      </div>
    </main>
  </div>

  <!-- 카테고리 추가 모달 -->
  <div id="categoryModal" class="modal-overlay hidden">
    <div class="modal">
      <div class="modal-header">📁 카테고리 추가</div>
      <div class="input-group">
        <label class="input-label">카테고리 이름</label>
        <input type="text" id="categoryName" class="input">
      </div>
      <div class="modal-footer">
        <button onclick="closeCategoryModal()" class="btn btn-outline">취소</button>
        <button onclick="createCategory()" class="btn btn-primary">추가</button>
      </div>
    </div>
  </div>

    <!-- 입고 로그 모달 -->
  <div id="restockLogModal" class="modal-overlay hidden">
    <div class="modal" style="max-width: 620px;">
      <div class="modal-header">📢 입고 로그 보내기</div>
      <p class="text-muted" style="margin: 0 0 14px;">마지막 입고 로그 이후 관리자가 직접 변경한 제품만 표시됩니다. 구매로 인한 재고 변화는 제외됩니다.</p>
      <div id="restockCandidateList" style="max-height: 280px; overflow-y: auto; border: 1px solid #333; border-radius: 6px; padding: 8px;">
        <div class="text-muted" style="padding: 8px;">로딩중...</div>
      </div>
      <div class="input-group" style="margin-top: 16px;">
        <label class="input-label" for="restockChannelId">입고 로그를 보낼 채널 ID</label>
        <input type="text" id="restockChannelId" class="input" inputmode="numeric" placeholder="예: 123456789012345678">
        <small class="text-muted">입력한 채널 ID는 이 브라우저의 로컬 저장소에 저장됩니다.</small>
      </div>
      <div class="modal-footer">
        <button onclick="closeRestockLogModal()" class="btn btn-outline">취소</button>
        <button onclick="sendRestockLog()" class="btn btn-success">입고 메시지 보내기</button>
      </div>
    </div>
  </div>

  <!-- 제품 추가/수정 모달 -->
  <div id="productModal" class="modal-overlay hidden">
    <div class="modal" style="max-width: 550px;">
      <div class="modal-header" id="productModalTitle">📦 제품 추가</div>
      <input type="hidden" id="productId">
      <input type="hidden" id="productCategoryId">
      <div class="input-group">
        <label class="input-label">제품명</label>
        <input type="text" id="productName" class="input">
      </div>
      <div class="input-group">
        <label class="input-label">가격 (원)</label>
        <input type="number" id="productPrice" class="input">
      </div>
      <div class="input-group">
        <label class="input-label">할인률 (%)</label>
        <input type="number" id="productDiscountRate" class="input" min="0" max="100" placeholder="0">
      </div>
      <div class="input-group">
        <label class="input-label">설명</label>
        <textarea id="productDescription" class="input" rows="3"></textarea>
      </div>
      <div class="input-group">
        <label class="input-label">
          <input type="checkbox" id="productIsFixed" onchange="toggleFixed()"> 고정 재고 사용
        </label>
      </div>
      <div id="fixedSection" class="input-group hidden">
        <label class="input-label">고정 재고 내용</label>
        <textarea id="productFixedContent" class="input" rows="3"></textarea>
      </div>
      <div class="modal-footer">
        <button onclick="closeProductModal()" class="btn btn-outline">취소</button>
        <button onclick="saveProduct()" class="btn btn-primary">저장</button>
      </div>
    </div>
  </div>

  <!-- 재고 관리 모달 -->
  <div id="stockModal" class="modal-overlay hidden">
    <div class="modal">
      <div class="modal-header">⚡ 재고 관리</div>
      <input type="hidden" id="stockProductId">

      <div class="input-group">
        <label class="input-label">현재 재고 목록 (<span id="stockCount">0</span>개)</label>
        <div id="stockList" style="max-height: 220px; overflow-y: auto; border: 1px solid #333; border-radius: 6px; padding: 8px;"></div>
      </div>

      <div class="input-group">
        <label class="input-label">새 재고 입력 (줄바꿈으로 구분)</label>
        <textarea id="stockContent" class="input" rows="6" placeholder="재고1&#10;재고2&#10;재고3"></textarea>
      </div>
      <div class="modal-footer">
        <button onclick="closeStockModal()" class="btn btn-outline">닫기</button>
        <button onclick="addStock()" class="btn btn-primary">추가하기</button>
      </div>
    </div>
  </div>

    <script>
    let categoriesData = [];
    let restockCandidates = [];
    const RESTOCK_CHANNEL_STORAGE_KEY = 'vendingbot.restockLogChannelId';

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, char => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      }[char]));
    }

    async function loadCategories() {
      const r = await fetch('/api/products');
      categoriesData = await r.json();
      const list = document.getElementById('categoryList');
      
      if (categoriesData.length === 0) {
        list.innerHTML = '<div class="card"><div class="text-muted text-center py-8">카테고리가 없습니다.</div></div>';
        return;
      }

      list.innerHTML = categoriesData.map(cat => `
        <div class="card mb-6">
          <div class="card-header flex justify-between align-center">
            <span>📁 ${cat.name}</span>
            <div class="flex gap-2">
              <button onclick='openProductModal(${JSON.stringify(cat.id)})' class="btn btn-sm btn-primary">➕ 제품 추가</button>
              <button onclick='deleteCategory(${JSON.stringify(cat.id)})' class="btn btn-sm btn-danger">삭제</button>
            </div>
          </div>
          <div class="table-container">
            <table class="table">
              <thead>
                <tr>
                  <th>제품명</th>
                  <th>정가</th>
                  <th>할인률</th>
                  <th>재고</th>
                  <th>유형</th>
                  <th>작업</th>
                </tr>
              </thead>
              <tbody>
                ${cat.products.length === 0 ? '<tr><td colspan="6" class="text-center text-muted">제품이 없습니다.</td></tr>' : 
                  cat.products.map(p => `
                  <tr class="border-t border-gray-700">
                    <td>${p.name}</td>
                    <td>${p.price.toLocaleString()}원</td>
                    <td>${p.discountRate > 0 ? `<span class="badge badge-success">${p.discountRate}%</span>` : '-'}</td>
                    <td>${p.isFixed ? '∞' : p.stocks.length}</td>
                    <td>${p.isFixed ? '고정' : '일반'}</td>
                    <td>
                      <div class="flex gap-2">
                        <button onclick='editProduct(${JSON.stringify(p).replace(/'/g, "&apos;")})' class="text-primary hover:underline">수정</button>
                        ${!p.isFixed ? `<button onclick='openStockModal(${JSON.stringify(p.id)})' class="text-success hover:underline">재고</button>` : ''}
                        <button onclick='deleteProduct(${JSON.stringify(p.id)})' class="text-danger hover:underline">삭제</button>
                      </div>
                    </td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        </div>
      `).join('');
    }

    async function openRestockLogModal() {
      document.getElementById('restockChannelId').value = localStorage.getItem(RESTOCK_CHANNEL_STORAGE_KEY) || '';
      document.getElementById('restockLogModal').classList.remove('hidden');
      document.getElementById('restockLogModal').classList.add('active');
      await loadRestockCandidates();
    }

    function closeRestockLogModal() {
      document.getElementById('restockLogModal').classList.add('hidden');
      document.getElementById('restockLogModal').classList.remove('active');
    }

    async function loadRestockCandidates() {
      const list = document.getElementById('restockCandidateList');
      list.innerHTML = '<div class="text-muted" style="padding: 8px;">로딩중...</div>';
      try {
        const response = await fetch('/api/products/restock-candidates');
        const candidates = await response.json();
        if (!response.ok) throw new Error(candidates.error || '입고 후보를 불러오지 못했습니다.');
        restockCandidates = candidates;

        if (candidates.length === 0) {
          list.innerHTML = '<div class="text-muted" style="padding: 8px;">새로운 관리자 재고 변경이 있는 제품이 없습니다.</div>';
          return;
        }

        list.innerHTML = candidates.map(product => `
          <label class="flex align-center" style="gap: 10px; padding: 9px 6px; border-bottom: 1px solid #2a2a2a; cursor: pointer;">
            <input type="checkbox" class="restock-product-checkbox" value="${escapeHtml(product.id)}" checked>
            <span style="flex: 1;">${escapeHtml(product.name)}</span>
            <span class="text-muted">${product.isFixed ? '고정 제품 · 신규 등록' : `재고 ${product.stockCount}개`}</span>
          </label>
        `).join('');
      } catch (error) {
        restockCandidates = [];
        list.innerHTML = `<div class="text-danger" style="padding: 8px;">${escapeHtml(error.message)}</div>`;
      }
    }

    async function sendRestockLog() {
      const channelId = document.getElementById('restockChannelId').value.trim();
      const productIds = Array.from(document.querySelectorAll('.restock-product-checkbox:checked'))
        .map(input => input.value);

      if (!/^\d{15,22}$/.test(channelId)) {
        return showToast('올바른 Discord 채널 ID를 입력하세요.', 'warning');
      }
      if (productIds.length === 0) {
        return showToast('입고 메시지에 포함할 제품을 하나 이상 선택하세요.', 'warning');
      }

      localStorage.setItem(RESTOCK_CHANNEL_STORAGE_KEY, channelId);
      const response = await fetch('/api/products/restock-log', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ channelId, productIds }),
      });
      const result = await response.json();
      if (!response.ok) {
        return showToast(result.error || '입고 메시지를 보내지 못했습니다.', 'error');
      }

      closeRestockLogModal();
      showToast(`${result.sentProductNames.length}개 제품의 입고 메시지를 보냈습니다.`, 'success');
      await loadCategories();
    }

    // 카테고리 관련 - 커스텀 모달 사용
    function openCategoryModal() { 
      document.getElementById('categoryModal').classList.remove('hidden');
      document.getElementById('categoryModal').classList.add('active');
    }
    function closeCategoryModal() { 
      document.getElementById('categoryModal').classList.add('hidden');
      document.getElementById('categoryModal').classList.remove('active');
    }
    async function createCategory() {
      const name = document.getElementById('categoryName').value;
      if (!name) return showToast('이름을 입력하세요.', 'warning');
      await fetch('/api/products/categories', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name })
      });
      closeCategoryModal();
      document.getElementById('categoryName').value = '';
      showToast('카테고리가 추가되었습니다.', 'success');
      loadCategories();
    }
    async function deleteCategory(id) {
      showConfirm('카테고리와 포함된 모든 제품이 삭제됩니다. 계속하시겠습니까?', async () => {
        await fetch(`/api/products/categories/${id}`, { method: 'DELETE' });
        showToast('카테고리가 삭제되었습니다.', 'success');
        loadCategories();
      });
    }

    // 제품 관련 - 커스텀 모달 사용
    function toggleFixed() {
      const isFixed = document.getElementById('productIsFixed').checked;
      document.getElementById('fixedSection').classList.toggle('hidden', !isFixed);
    }
    function openProductModal(catId) {
      document.getElementById('productModalTitle').textContent = '📦 제품 추가';
      document.getElementById('productId').value = '';
      document.getElementById('productCategoryId').value = catId;
      document.getElementById('productName').value = '';
      document.getElementById('productPrice').value = '';
      document.getElementById('productDiscountRate').value = '0';
      document.getElementById('productDescription').value = '';
      document.getElementById('productIsFixed').checked = false;
      document.getElementById('productFixedContent').value = '';
      toggleFixed();
      document.getElementById('productModal').classList.remove('hidden');
      document.getElementById('productModal').classList.add('active');
    }
    function editProduct(p) {
      document.getElementById('productModalTitle').textContent = '📦 제품 수정';
      document.getElementById('productId').value = p.id;
      document.getElementById('productCategoryId').value = p.categoryId;
      document.getElementById('productName').value = p.name;
      document.getElementById('productPrice').value = p.price;
      document.getElementById('productDiscountRate').value = p.discountRate || 0;
      document.getElementById('productDescription').value = p.description || '';
      document.getElementById('productIsFixed').checked = p.isFixed;
      document.getElementById('productFixedContent').value = p.fixedContent || '';
      toggleFixed();
      document.getElementById('productModal').classList.remove('hidden');
      document.getElementById('productModal').classList.add('active');
    }
    function closeProductModal() { 
      document.getElementById('productModal').classList.add('hidden');
      document.getElementById('productModal').classList.remove('active');
    }
    async function saveProduct() {
      const id = document.getElementById('productId').value;
      const name = document.getElementById('productName').value;
      const price = document.getElementById('productPrice').value;
      
      if (!name) return showToast('제품명을 입력하세요.', 'warning');
      if (!price) return showToast('가격을 입력하세요.', 'warning');
      
      const data = {
        name,
        price: parseInt(price),
        discountRate: parseInt(document.getElementById('productDiscountRate').value) || 0,
        description: document.getElementById('productDescription').value,
        isFixed: document.getElementById('productIsFixed').checked,
        fixedContent: document.getElementById('productFixedContent').value,
        categoryId: document.getElementById('productCategoryId').value
      };
      
      const method = id ? 'PUT' : 'POST';
      const url = id ? `/api/products/${id}` : '/api/products';
      await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      
      closeProductModal();
      showToast(id ? '제품이 수정되었습니다.' : '제품이 추가되었습니다.', 'success');
      loadCategories();
    }
    async function deleteProduct(id) {
      showConfirm('이 제품을 삭제하시겠습니까?', async () => {
        await fetch(`/api/products/${id}`, { method: 'DELETE' });
        showToast('제품이 삭제되었습니다.', 'success');
        loadCategories();
      });
    }

    // 재고 관련 - 커스텀 모달 사용
    function openStockModal(id) {
      document.getElementById('stockProductId').value = id;
      document.getElementById('stockContent').value = '';
      renderStockList(id);
      document.getElementById('stockModal').classList.remove('hidden');
      document.getElementById('stockModal').classList.add('active');
    }

    function renderStockList(productId) {
      const product = categoriesData
        .flatMap(cat => cat.products)
        .find(p => p.id === productId);

      const stocks = product?.stocks || [];
      document.getElementById('stockCount').textContent = stocks.length;

      const listEl = document.getElementById('stockList');
      if (stocks.length === 0) {
        listEl.innerHTML = '<div class="text-muted" style="padding: 8px;">등록된 재고가 없습니다.</div>';
        return;
      }

      listEl.innerHTML = stocks.map(s => `
        <div class="flex justify-between align-center" style="padding: 6px 4px; border-bottom: 1px solid #2a2a2a;">
          <span style="word-break: break-all; margin-right: 8px;">${s.content}</span>
          <button onclick="deleteStockItem('${s.id}', '${productId}')" class="text-danger hover:underline" style="flex-shrink: 0;">삭제</button>
        </div>
      `).join('');
    }

    async function deleteStockItem(stockId, productId) {
      if (!confirm('이 재고를 삭제하시겠습니까?')) return;

      await fetch(`/api/products/stocks/${stockId}`, { method: 'DELETE' });
      showToast('재고가 삭제되었습니다.', 'success');

      // 목록/테이블 갱신
      await loadCategories();
      renderStockList(productId);
    }

    function closeStockModal() { 
      document.getElementById('stockModal').classList.add('hidden');
      document.getElementById('stockModal').classList.remove('active');
    }
    async function addStock() {
      const id = document.getElementById('stockProductId').value;
      const content = document.getElementById('stockContent').value;
      if (!content) return showToast('내용을 입력하세요.', 'warning');
      const stocks = content.split('\n').filter(s => s.trim());
      for (const s of stocks) {
        await fetch(`/api/products/${id}/stocks`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content: s })
        });
      }
      showToast(`${stocks.length}개의 재고가 추가되었습니다.`, 'success');
      document.getElementById('stockContent').value = '';
      await loadCategories();
      renderStockList(id);
    }

    loadCategories();
  </script>
  <script src="/js/common.js"></script>
</body>
</html>
