<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>관리자 페이지 [24H]</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/png" href="/favicon.png">
</head>
<body>
  <div class="dashboard-container">
    <aside class="sidebar">
      <h1 class="sidebar-title">관리자 대시보드</h1>
      <nav class="sidebar-nav">
        <a href="/admin" class="nav-link"><span></span> 홈 / 대시보드</a>
        <a href="/admin/products" class="nav-link"><span></span> 상품 관리</a>
        <a href="/admin/logs" class="nav-link"><span></span> 로그</a>
        <a href="/admin/settings" class="nav-link active"><span></span> 설정</a>
        <a href="/admin/embed" class="nav-link"><span></span> 임베드</a>
        <a href="/admin/roles" class="nav-link"><span></span> 역할 관리</a>
      </nav>
      <div class="sidebar-footer">
        <div class="user-profile">
          <% if (user.avatar) { %>
            <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=128" class="user-avatar" alt="유저 아바타">
          <% } else { %>
            <img src="https://cdn.discordapp.com/embed/avatars/0.png" class="user-avatar" alt="유저 아바타">
          <% } %>
          <div class="user-name"><%= user.username || '관리자' %></div>
        </div>
        <a href="/dashboard" class="nav-link"><span>👤</span> 내 대시보드</a>
        <a href="/auth/logout" class="logout-link-animated"><span>🚪</span> 로그아웃</a>
      </div>
    </aside>
    
    <main class="main-content">
      <div class="page-header">
        <h1 class="title-md">시스템 설정</h1>
      </div>

      <div class="card mb-6">
        <div class="card-header">서버 초대 링크</div>
        <div class="flex gap-2">
          <input type="text" id="serverLink" placeholder="https://discord.gg/xxxxx" class="input" style="flex: 1;">
          <button onclick="saveServerLink()" class="btn btn-primary">저장</button>
        </div>
      </div>

      <div class="settings-card-grid mb-6">
        <div class="card setting-equal-card">
          <div class="card-header">계좌 정보 / 최소 충전금액</div>
          
          <div class="card-inner-flow left-inputs-balance">
            <div class="input-group">
              <input type="text" id="bankName" placeholder="은행명 (예: 국민은행)" class="input">
            </div>
            <div class="input-group">
              <input type="text" id="accountNumber" placeholder="계좌번호 (예: 123-456-789)" class="input">
            </div>
            <div class="input-group">
              <input type="text" id="accountHolder" placeholder="예금주명 (예: 홍길동)" class="input">
            </div>
            <div class="input-group">
              <input type="number" id="minDeposit" placeholder="최소 충전 금액" class="input">
            </div>
          </div>
          
          <div class="card-action-row">
            <button onclick="saveBankSettings()" class="btn btn-primary" style="width: 100%;">저장</button>
          </div>
        </div>
        
        <div class="card setting-equal-card">
          <div class="card-header">디스코드 로그 채널 ID</div>
          
          <div class="card-inner-flow right-inputs-balance">
            <div class="input-group">
              <input type="text" id="reviewLogChannel" placeholder="리뷰 로그 채널 ID" class="input">
            </div>
            <div class="input-group">
              <input type="text" id="purchaseLogChannel" placeholder="구매 로그 채널 ID" class="input">
            </div>
            <div class="input-group">
              <input type="text" id="chargeLogChannel" placeholder="충전 로그 채널 ID" class="input">
            </div>
          </div>

          <div class="card-action-row">
            <button onclick="saveChannelSettings()" class="btn btn-primary" style="width: 100%;">저장</button>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">자동 SMS 충전 설정 가이드</div>
        <div class="flex gap-4 mb-4">
          <button onclick="showGuide('android')" id="btnAndroid" class="btn btn-success">Android</button>
          <button onclick="showGuide('ios')" id="btnIos" class="btn btn-outline">iOS</button>
        </div>
        <div id="guideContent" class="guide-box"></div>
      </div>
    </main>
  </div>

  <style>
    @media (min-width: 769px) {
      .settings-card-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
      }
    }

    .setting-equal-card {
      display: flex;
      flex-direction: column;
      height: 100%;
      min-height: 340px;
    }

    .setting-equal-card .card-header {
      margin-bottom: 12px;
    }

    .card-inner-flow {
      display: flex;
      flex-direction: column;
      flex: 1;
      gap: 12px;
    }

    .card-inner-flow.left-inputs-balance {
      justify-content: space-around;
      padding: 6px 0;
    }

    .card-inner-flow.right-inputs-balance {
      gap: 12px;
      justify-content: flex-start;
    }
    
    .setting-equal-card .input-group {
      margin-bottom: 0 !important;
    }

    .card-action-row {
      margin-top: auto;
      padding-top: 16px;
    }

    .guide-box {
      background: var(--bg-darker, #252830);
      border: 1px solid var(--border-color, #333);
      border-radius: 8px;
      padding: 1.25rem;
      color: #dcddde;
      font-family: monospace;
      white-space: pre-wrap;
      line-height: 1.6;
    }
  </style>

  <script>
    const keyToIdMap = {
      "BANK_NAME": "bankName",
      "ACCOUNT_NUMBER": "accountNumber",
      "ACCOUNT_HOLDER": "accountHolder",
      "MIN_DEPOSIT": "minDeposit",
      "REVIEW_CHANNEL_ID": "reviewLogChannel",
      "PURCHASE_LOG_CHANNEL": "purchaseLogChannel",
      "CHARGE_LOG_CHANNEL": "chargeLogChannel",
      "SERVER_LINK": "serverLink"
    };

    // 공통 토스트 메시지 호출 함수 (common.js가 없거나 동작 안 할 시 대처용 폴리필)
    function notify(message, type = "success") {
      if (typeof showToast === "function") {
        showToast(message, type);
      } else {
        alert(message);
      }
    }

    async function loadSettings() {
      try {
        const r = await fetch("/api/settings");
        const d = await r.json();
        
        if (d.settings && Array.isArray(d.settings)) {
          d.settings.forEach(s => {
            const targetId = keyToIdMap[s.key];
            if (targetId) {
              const el = document.getElementById(targetId);
              if (el) el.value = s.value;
            }
          });
        }
      } catch (e) {
        console.error("설정을 불러오는 중 오류가 발생했습니다:", e);
      }
    }

    async function saveSetting(k, v) {
      return await fetch("/api/settings", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ key: k, value: v })
      });
    }

    async function saveServerLink() {
      const serverLink = document.getElementById("serverLink").value;
      await saveSetting("SERVER_LINK", serverLink);
      notify("서버 링크가 저장되었습니다.", "success");
    }

    async function saveBankSettings() {
      const bankName = document.getElementById("bankName").value;
      const accountNumber = document.getElementById("accountNumber").value;
      const accountHolder = document.getElementById("accountHolder").value;
      const minDeposit = document.getElementById("minDeposit").value;

      await Promise.all([
        saveSetting("BANK_NAME", bankName),
        saveSetting("ACCOUNT_NUMBER", accountNumber),
        saveSetting("ACCOUNT_HOLDER", accountHolder),
        saveSetting("MIN_DEPOSIT", minDeposit)
      ]);
      
      notify("계좌 정보가 저장되었습니다.", "success");
    }

    async function saveChannelSettings() {
      const channelMappings = [
        { key: "REVIEW_CHANNEL_ID", value: document.getElementById("reviewLogChannel").value },
        { key: "PURCHASE_LOG_CHANNEL", value: document.getElementById("purchaseLogChannel").value },
        { key: "CHARGE_LOG_CHANNEL", value: document.getElementById("chargeLogChannel").value },
      ];

      const requests = channelMappings
        .filter(item => item.value !== undefined)
        .map(item => saveSetting(item.key, item.value));

      await Promise.all(requests);
      notify("로그 채널 설정이 저장되었습니다.", "success");
    }

    const pushbulletGuide = `Pushbullet 자동충전 설정 (Android)

1. Pushbullet Android 앱을 설치합니다.
2. Pushbullet 앱에서 Notification Mirroring을 켭니다.
3. .env에 PUSHBULLET_TOKEN 값을 입력합니다.
4. 입금 문자/알림이 Pushbullet 스트림으로 들어오면 서버가 자동으로 처리합니다.
5. SMS Forwarder, webhook/sms, WEBHOOK_SECRET은 더 이상 사용하지 않습니다.`;

    const iosGuide = `iOS 가이드

iOS 환경에서는 Pushbullet 알림 미러링을 지원하지 않습니다. 
Android 기기를 이용해 연결해 주시기 바랍니다.`;

    function showGuide(platform = 'android') {
      const guideBox = document.getElementById("guideContent");
      const btnAndroid = document.getElementById("btnAndroid");
      const btnIos = document.getElementById("btnIos");

      if (platform === 'ios') {
        guideBox.textContent = iosGuide;
        btnAndroid.className = "btn btn-outline";
        btnIos.className = "btn btn-success";
      } else {
        guideBox.textContent = pushbulletGuide;
        btnAndroid.className = "btn btn-success";
        btnIos.className = "btn btn-outline";
      }
    }

    loadSettings();
    showGuide('android');
  </script>
  <script src="/js/common.js"></script>
</body>
</html>