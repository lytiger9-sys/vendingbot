<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>후기 작성 | 최저가 NO.1 발로랜계 킬조이샵 [24H]</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/png" href="/favicon.png">
</head>
<body>
  <div class="dashboard-container">
    <aside class="sidebar">
      <h1 class="sidebar-title">킬조이샵</h1>
      <nav class="sidebar-nav">
        <a href="/dashboard" class="nav-link"><span></span> 내 대시보드</a>
        <a href="/dashboard/review" class="nav-link active"><span></span> 후기 작성</a>
      </nav>
      <div class="sidebar-footer">
        <div class="user-profile">
          <% if (user.avatar) { %>
            <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=128" class="user-avatar" alt="프로필">
          <% } else { %>
            <img src="https://cdn.discordapp.com/embed/avatars/0.png" class="user-avatar" alt="프로필">
          <% } %>
          <div class="user-name"><%= user.username || '사용자' %></div>
        </div>
        <% if (isAdmin) { %>
          <a href="/admin" class="nav-link"><span>⚙️</span> 관리자 페이지</a>
        <% } %>
        <a href="/auth/logout" class="logout-link-animated"><span>🚪</span> 로그아웃</a>
      </div>
    </aside>
    <main class="main-content">
      <div class="page-header">
        <h1 class="title-md">⭐ 후기 작성</h1>
      </div>

      <div id="reviewList">
        <div class="text-muted">로딩중...</div>
      </div>

      <script>
        let receipts = [];

        async function loadReceipts() {
          const r = await fetch('/dashboard/purchases');
          receipts = await r.json();
          renderList();
        }

        function renderList() {
          const container = document.getElementById('reviewList');
          const unreviewed = receipts.filter(r => !r.hasReview);
          const reviewed = receipts.filter(r => r.hasReview);

          if (receipts.length === 0) {
            container.innerHTML = '<div class="card"><div class="text-muted" style="padding: 24px;">구매 내역이 없습니다.</div></div>';
            return;
          }

          let html = '';

          if (unreviewed.length > 0) {
            html += '<div class="card-header" style="margin-bottom: 12px;">후기 작성 대기중 (' + unreviewed.length + ')</div>';
            html += unreviewed.map(r => renderReviewCard(r)).join('');
          } else {
            html += '<div class="card"><div class="text-muted" style="padding: 24px;">후기를 작성할 수 있는 구매 내역이 없습니다.</div></div>';
          }

          if (reviewed.length > 0) {
            html += '<div class="card-header" style="margin: 24px 0 12px;">작성 완료된 후기 (' + reviewed.length + ')</div>';
            html += reviewed.map(r => renderCompletedCard(r)).join('');
          }

          container.innerHTML = html;
        }

        function renderReviewCard(r) {
          const productName = r.product?.name || '알 수 없는 상품';
          const date = new Date(r.purchasedAt || r.createdAt).toLocaleString('ko-KR');

          return `
            <div class="card mb-6">
              <div class="card-header">${productName} · ${r.paidAmount.toLocaleString()}원</div>
              <div class="text-muted" style="margin-bottom: 16px; font-size: 0.9rem;">구매일: ${date}</div>
              <div class="input-group">
                <label class="input-label">평점</label>
                <select id="rating_${r.id}" class="input">
                  <option value="5">★★★★★</option>
                  <option value="4">★★★★☆</option>
                  <option value="3">★★★☆☆</option>
                  <option value="2">★★☆☆☆</option>
                  <option value="1">★☆☆☆☆</option>
                </select>
              </div>
              <div class="input-group">
                <label class="input-label">후기 내용</label>
                <textarea id="content_${r.id}" class="input" rows="4" style="resize: vertical;" placeholder="상품에 대한 솔직한 후기를 남겨주세요."></textarea>
              </div>
              <button onclick="submitReview('${r.id}')" class="btn btn-primary">후기 등록</button>
            </div>
          `;
        }

        function renderCompletedCard(r) {
          const productName = r.product?.name || '알 수 없는 상품';
          const stars = '★'.repeat(r.reviewRating || 0) + '☆'.repeat(5 - (r.reviewRating || 0));

          return `
            <div class="card mb-6">
              <div class="card-header">${productName}</div>
              <div class="text-warning" style="margin: 8px 0;">${stars}</div>
              <div style="color: #ccc; white-space: pre-wrap;">${r.reviewContent || ''}</div>
            </div>
          `;
        }

        async function submitReview(receiptId) {
          const rating = document.getElementById('rating_' + receiptId).value;
          const content = document.getElementById('content_' + receiptId).value;

          if (!content || content.trim() === '') {
            alert('후기 내용을 입력해주세요.');
            return;
          }

          const r = await fetch('/dashboard/reviews', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ receiptId, rating, content })
          });

          if (r.ok) {
            alert('후기가 작성되었습니다.');
            loadReceipts();
          } else {
            alert('후기 작성에 실패했습니다.');
          }
        }

        loadReceipts();
      </script>
    </main>
  </div>
</body>
</html>
